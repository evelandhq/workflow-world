{
  "name": "@evelandhq/workflow-world",
  "version": "0.1.0",
  "description": "Natively multi-tenant Workflow World for the Vercel Workflow SDK, plus the dispatcher that drives it out of process",
  "keywords": [
    "durable-execution",
    "multi-tenant",
    "postgres",
    "workflow",
    "world"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evelandhq/workflow-world.git"
  },
  "bin": {
    "workflow-dispatcher": "./bin/dispatcher.js",
    "workflow-world-setup": "./bin/setup.js"
  },
  "files": [
    "dist",
    "bin",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/drizzle/schema.d.ts",
      "import": "./dist/drizzle/schema.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    },
    "./dispatcher": {
      "types": "./dist/dispatcher/index.d.ts",
      "import": "./dist/dispatcher/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "prepack": "npm run build",
    "test:conformance": "npm run build && vitest run --config conformance/vitest.config.mts",
    "test:e2e": "vitest run --config e2e-tests/vitest.config.mts",
    "check:long-step": "npm run build && node scripts/long-step-lease.mjs"
  },
  "dependencies": {
    "@workflow/errors": "5.0.0-beta.15",
    "@workflow/utils": "5.0.0-beta.8",
    "@workflow/world": "5.0.0-beta.24",
    "@workflow/world-local": "5.0.0-beta.33",
    "cbor-x": "1.6.0",
    "drizzle-orm": "0.45.2",
    "graphile-worker": "0.16.6",
    "pg": "8.20.0",
    "ulid": "~3.0.1",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@workflow/core": "5.0.0-beta.39",
    "@workflow/world-testing": "5.0.0-beta.39",
    "eve": "0.30.6",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
